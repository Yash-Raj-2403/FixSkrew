# --- Server ---
PORT=8787
# Comma-separated list of allowed browser origins (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# --- MongoDB Atlas ---
# Atlas cluster connection string (Vector Search requires an Atlas cluster, M0 works)
MONGODB_URI=
MONGODB_DB=fixskrew
MONGODB_COLLECTION=chunks
MONGODB_VECTOR_INDEX=chunks_vector_index

# --- AI providers ---
# Google Gemini: one key covers embeddings (gemini-embedding-2) and the language model.
GEMINI_API_KEY=
# Optional alternatives. When set, they take precedence over Gemini for their role.
VOYAGE_API_KEY=
ANTHROPIC_API_KEY=

# Override automatic selection: EMBEDDING_PROVIDER=gemini|voyage, LLM_PROVIDER=gemini|anthropic
# EMBEDDING_PROVIDER=
# LLM_PROVIDER=

# Embedding model and size (defaults: gemini-embedding-2 / voyage-3.5, 1024 dimensions).
# Changing either requires re-creating the vector index and re-ingesting documents.
# EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
# Set to false with an English-only embedding model: queries are then translated first.
EMBEDDING_MULTILINGUAL=true

# Language models (defaults: gemini-flash-latest, or claude-opus-5-5 with Anthropic).
# LLM_MODEL is used for reports; LLM_FAST_MODEL for chat, document extraction and translation.
# LLM_MODEL=
# LLM_FAST_MODEL=
LLM_EFFORT=high

# --- Retrieval tuning ---
RETRIEVAL_LIMIT=10
# Minimum Atlas vectorSearchScore ((1 + cosine) / 2) for a chunk to count as evidence.
# Defaults: 0.85 for Gemini embeddings, 0.78 for Voyage.
# RETRIEVAL_MIN_SCORE=
