{
  "name": "@fixskrew/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ingest": "tsx --env-file-if-exists=.env scripts/ingest.ts",
    "create-index": "tsx --env-file-if-exists=.env scripts/create-index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@google/genai": "2.24.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "mongodb": "^6.21.0",
    "multer": "^2.4.0",
    "unpdf": "^1.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3"
  }
}
